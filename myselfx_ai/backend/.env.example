# MyselfX AI Environment Variables

# === Project ===
PROJECT_NAME=MyselfX AI
DEBUG=true
ENVIRONMENT=local

# === SQLite ===
SQLITE_PATH=./myselfx_ai.db

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === AI Agent (pydantic_ai, openai) ===
# Set OPENAI_API_KEY to enable real AI responses
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.7

# === CORS ===
# JSON list of allowed origins (frontend domains)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://myselfx-ai.vercel.app"]
