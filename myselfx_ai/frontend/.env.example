# Backend API URL (server-side only - not exposed to browser)
BACKEND_URL=http://localhost:8000

# WebSocket URL for real-time features
# If not set, the chat falls back to offline demo mode
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Public site URL (used for metadata/SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: deploy the same URL to Vercel
# NEXT_PUBLIC_SITE_URL=https://myselfx-ai.vercel.app
